{
  target {
    test {
      main "_test.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
    test-wasm {
      main "_test.nt",
      platform "wasm32",
      execute "wasmtime {{executable}}",
    },
  },
  dependency {
    core {
      digest "XfFV2TbkGgQbBv9N7WgZbP4J9QIE8NO9e2o9YhtmyVA",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.8.tar.zst",
      ],
      enable-preset true,
    },
    noa {
      digest "_tidy0-6otOXozxCtDWpvIlb3ESjC5eJUptybErE1o8",
      mirror [
        "https://github.com/vekatze/noa/raw/main/archive/0.5.5.tar.zst",
      ],
    },
  },
}
