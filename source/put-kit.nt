import {
  core.binary {binary},
  core.binary.builder {
    append-binary,
    append-float16,
    append-float32,
    append-float64,
    append-int16,
    append-int32,
    append-int64,
    append-int8,
    append-string,
    binary-builder,
    extract,
    make-binary-builder,
  },
  core.string {byte-length},
}

data put-kit {
| _Put-Kit(
    buffer: binary-builder,
  )
}

define make-put-kit(buffer-size: int) -> put-kit {
  let buffer = make-binary-builder(buffer-size);
  _Put-Kit{buffer}
}

define extract-binary(k: put-kit) -> binary {
  let _Put-Kit{buffer} = k;
  extract(buffer)
}

define put-int8(k: &put-kit, x: int8) -> unit {
  tie _Put-Kit{buffer} = k;
  append-int8(buffer, x)
}

define put-int16(k: &put-kit, x: int16) -> unit {
  tie _Put-Kit{buffer} = k;
  append-int16(buffer, x)
}

define put-int32(k: &put-kit, x: int32) -> unit {
  tie _Put-Kit{buffer} = k;
  append-int32(buffer, x)
}

define put-int64(k: &put-kit, x: int64) -> unit {
  tie _Put-Kit{buffer} = k;
  append-int64(buffer, x)
}

define put-float16(k: &put-kit, x: float16) -> unit {
  tie _Put-Kit{buffer} = k;
  append-float16(buffer, x)
}

define put-float32(k: &put-kit, x: float32) -> unit {
  tie _Put-Kit{buffer} = k;
  append-float32(buffer, x)
}

define put-float64(k: &put-kit, x: float64) -> unit {
  tie _Put-Kit{buffer} = k;
  append-float64(buffer, x)
}

define put-binary(k: &put-kit, x: &binary) -> unit {
  tie _Put-Kit{buffer} = k;
  let len = core.binary.length(x);
  put-int64(k, len);
  append-binary(buffer, x)
}

define put-string(k: &put-kit, x: &string) -> unit {
  tie _Put-Kit{buffer} = k;
  let len = byte-length(x);
  put-int64(k, len);
  append-string(buffer, x)
}
