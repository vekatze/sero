import {
  this.get-kit {get-float16, get-kit},
  this.put-kit {put-float16, put-kit},
  this.sero {Sero, sero},
}

define _put(k: &put-kit, x: &float16) -> unit {
  put-float16(k, *x)
}

define _get(k: &get-kit) -> ?+float16 {
  try v = get-float16(k);
  Right(lift {v})
}

constant float16-sero: sero(float16) {
  Sero{
    put := _put,
    get := _get,
  }
}
