import {
  this.get-kit {get-kit, get-string},
  this.put-kit {put-kit, put-string},
  this.sero {Sero, sero},
}

define _put(k: &put-kit, x: &string) -> unit {
  put-string(k, x)
}

define _get(k: &get-kit) -> ?+string {
  try t = get-string(k);
  Right(lift {t})
}

constant string-sero: sero(string) {
  Sero{
    put := _put,
    get := _get,
  }
}
