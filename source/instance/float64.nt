import {
  this.get-kit {get-float64, get-kit},
  this.put-kit {put-float64, put-kit},
  this.sero {Sero, sero},
}

define _put(k: &put-kit, x: &float64) -> unit {
  put-float64(k, *x)
}

define _get(k: &get-kit) -> ?+float64 {
  try v = get-float64(k);
  Right(lift {v})
}

constant float64-sero: sero(float64) {
  Sero{
    put := _put,
    get := _get,
  }
}
