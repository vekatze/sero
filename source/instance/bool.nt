import {
  get-kit {get-int8, get-kit},
  put-kit {put-int8, put-kit},
  sero {Sero, sero},
}

define _put(k: &put-kit, x: &bool) -> unit {
  if *x {
    put-int8(k, 1)
  } else {
    put-int8(k, 0)
  }
}

define _get(k: &get-kit) -> ?+bool {
  try v = get-int8(k);
  Right(lift {eq-int8(v, 1)})
}

constant bool-sero: sero(bool) {
  Sero{
    put := _put,
    get := _get,
  }
}
