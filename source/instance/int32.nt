import {
  this.get-kit {get-int32, get-kit},
  this.put-kit {put-int32, put-kit},
  this.sero {Sero, sero},
}

define _put(k: &put-kit, x: &int32) -> unit {
  put-int32(k, *x)
}

define _get(k: &get-kit) -> ?+int32 {
  try v = get-int32(k);
  Right(lift {v})
}

constant int32-sero: sero(int32) {
  Sero{
    put := _put,
    get := _get,
  }
}
