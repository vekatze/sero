import {
  get-kit {get-int16, get-kit},
  put-kit {put-int16, put-kit},
  sero {Sero, sero},
}

define _put(k: &put-kit, x: &int16) -> unit {
  put-int16(k, *x)
}

define _get(k: &get-kit) -> ?+int16 {
  try v = get-int16(k);
  Right(lift {v})
}

constant int16-sero: sero(int16) {
  Sero{
    put := _put,
    get := _get,
  }
}
