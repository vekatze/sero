import {
  get-kit {get-kit},
  put-kit {put-kit},
  sero {Sero, sero},
}

inline _put<a, b>(m1: sero(a), m2: sero(b)) -> (k: &put-kit, xy: &pair(a, b)) -> unit {
  (k, xy) => {
    tie Pair(x, y) = xy;
    let Sero{put := put1} = m1;
    let Sero{put := put2} = m2;
    put1(k, x);
    put2(k, y)
  }
}

inline _get<a, b>(m1: sero(a), m2: sero(b)) -> (k: &get-kit) -> ?+pair(a, b) {
  (k) => {
    let Sero{get := get1} = m1;
    let Sero{get := get2} = m2;
    try l = get1(k);
    try r = get2(k);
    Right(box {
      letbox l = l;
      letbox r = r;
      Pair(l, r)
    })
  }
}

inline pair-sero<a, b>(!m1: sero(a), !m2: sero(b)) -> sero(pair(a, b)) {
  Sero{
    put := _put(m1, m2),
    get := _get(m1, m2),
  }
}
