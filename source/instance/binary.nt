import {
  core::binary {binary},
  get-kit {get-binary, get-kit},
  put-kit {put-binary, put-kit},
  sero {Sero, sero},
}

define _put(k: &put-kit, x: &binary) -> unit {
  put-binary(k, x)
}

define _get(k: &get-kit) -> ?+binary {
  try b = get-binary(k);
  Right(lift {b})
}

constant binary-sero: sero(binary) {
  Sero{
    put := _put,
    get := _get,
  }
}
