import {
  this.get-kit {get-int8, get-kit},
  this.put-kit {put-int8, put-kit},
  this.sero {Sero, sero},
}

inline _put<a>(!m: sero(a)) -> (k: &put-kit, xs: &list(a)) -> unit {
  define self(k: &put-kit, xs: &list(a)) -> unit {
    case xs {
    | Nil =>
      put-int8(k, 0)
    | Cons(y, ys) =>
      let Sero{put} = m;
      put-int8(k, 1);
      put(k, y);
      self(k, ys)
    }
  }
}

inline _get<a>(!m: sero(a)) -> (k: &get-kit) -> ?+list(a) {
  define self(k: &get-kit) -> ?+list(a) {
    try tag = get-int8(k);
    if eq-int8(tag, 0) {
      Right(box {Nil})
    } else-if eq-int8(tag, 1) {
      let Sero{get} = m;
      try v = get(k);
      try vs = self(k);
      Right(box {
        letbox v = v;
        letbox vs = vs;
        Cons(v, vs)
      })
    } else {
      none
    }
  }
}

inline list-sero<a>(!m: sero(a)) -> sero(list(a)) {
  Sero{
    put := _put(m),
    get := _get(m),
  }
}
