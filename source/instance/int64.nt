import {
  this.get-kit {get-int64, get-kit},
  this.put-kit {put-int64, put-kit},
  this.sero {Sero, sero},
}

define _put(k: &put-kit, x: &int64) -> unit {
  put-int64(k, *x)
}

define _get(k: &get-kit) -> ?+int64 {
  try v = get-int64(k);
  Right(lift {v})
}

constant int64-sero: sero(int64) {
  Sero{
    put := _put,
    get := _get,
  }
}
