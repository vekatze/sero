import {
  this.get-kit {get-int8, get-kit},
  this.put-kit {put-int8, put-kit},
  this.sero {Sero, sero},
}

inline _put<a, b>(m1: sero(a), m2: sero(b)) -> (k: &put-kit, x-or-y: &either(a, b)) -> unit {
  (k, x-or-y) => {
    case x-or-y {
    | Left(x) =>
      let Sero{put} = m1;
      put-int8(k, 0);
      put(k, x)
    | Right(y) =>
      let Sero{put} = m2;
      put-int8(k, 1);
      put(k, y)
    }
  }
}

inline _get<a, b>(m1: sero(a), m2: sero(b)) -> (k: &get-kit) -> ?+either(a, b) {
  (k) => {
    try tag = get-int8(k);
    if eq-int8(tag, 0) {
      let Sero{get} = m1;
      try l = get(k);
      Right(box {
        letbox l = l;
        Left(l)
      })
    } else-if eq-int8(tag, 1) {
      let Sero{get} = m2;
      try r = get(k);
      Right(box {
        letbox r = r;
        Right(r)
      })
    } else {
      none
    }
  }
}

inline either-sero<a, b>(!m1: sero(a), !m2: sero(b)) -> sero(either(a, b)) {
  Sero{
    put := _put(m1, m2),
    get := _get(m1, m2),
  }
}
