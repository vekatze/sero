import {
  get-kit {get-float32, get-kit},
  put-kit {put-float32, put-kit},
  sero {Sero, sero},
}

define _put(k: &put-kit, x: &float32) -> unit {
  put-float32(k, *x)
}

define _get(k: &get-kit) -> ?+float32 {
  try v = get-float32(k);
  Right(lift {v})
}

constant float32-sero: sero(float32) {
  Sero{
    put := _put,
    get := _get,
  }
}
