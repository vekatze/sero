import {
  core::string {to-binary},
  core::string.unsafe {from-binary},
  decode {decode},
  encode {encode},
  instance.binary {binary-sero},
}

define zen() -> unit {
  pin value = *to-binary("枝ごとに花散りまがへ今はとて春の過ぎゆく道見えぬまで");
  match decode(binary-sero, encode(binary-sero, value, 12345)) {
  | Left(_) =>
    print("left")
  | Right(v) =>
    pin v = from-binary(v);
    print("value: ");
    print-line(v);
  }
}
