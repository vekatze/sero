import {
  core.int.io {print-int-line},
  this.decode {decode},
  this.encode {encode},
  this.instance.int64 {int64-sero},
  this.instance.vector {vector-sero},
  this.sero {sero},
}

constant _int-vector: sero(vector(int)) {
  vector-sero(int64-sero)
}

define zen() -> unit {
  pin val = core.vector.from-list(List[1, 2, -123, 1384910234]);
  match decode(_int-vector, encode(_int-vector, val, 8)) {
  | Left(_) =>
    print("left\n")
  | Right(vs) =>
    print("int-vector\n");
    pin vs = vs;
    core.vector.for-N(vs, (v, _) => {
      print("val: ");
      print-int-line(*v);
    })
  }
}
