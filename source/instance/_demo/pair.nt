import {
  core::bool.show,
  core::int.io {print-int-line},
  decode {decode},
  encode {encode},
  instance.bool {bool-sero},
  instance.int64 {int64-sero},
  instance.pair {pair-sero},
  sero {sero},
}

constant _pair-int-bool: sero(pair(int, bool)) {
  pair-sero(int64-sero, bool-sero)
}

define zen() -> unit {
  pin val = Pair(-1234, True);
  match decode(_pair-int-bool, encode(_pair-int-bool, val, 8)) {
  | Left(_) =>
    print("left\n")
  | Right(xy) =>
    let Pair(x, y) = xy;
    print("int: ");
    print-int-line(x);
    print("bool: ");
    pin y = core::bool.show.show(y);
    print-line(y);
  }
}
