import {
  core::float.io {print-float-line},
  decode {decode},
  encode {encode},
  instance.float64 {float64-sero},
}

define zen() -> unit {
  pin val = -3.8;
  match decode(float64-sero, encode(float64-sero, val, 8)) {
  | Left(_) =>
    print("left")
  | Right(v) =>
    print("value: ");
    print-float-line(v);
  }
}
