import {
  core::rune.show {show-rune},
  decode {decode},
  encode {encode},
  instance.rune {rune-sero},
}

define zen() -> unit {
  pin val = `あ`;
  match decode(rune-sero, encode(rune-sero, val, 4)) {
  | Left(_) =>
    print("left")
  | Right(v) =>
    pin v = show-rune(v);
    print("value: ");
    print-line(v);
  }
}
