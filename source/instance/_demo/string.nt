import {
  decode {decode},
  encode {encode},
  instance.string {string-sero},
}

define zen() -> unit {
  tie value = "枝ごとに花散りまがへ今はとて春の過ぎゆく道見えぬまで";
  match decode(string-sero, encode(string-sero, value, 4)) {
  | Left(_) =>
    print("left")
  | Right(v) =>
    pin v = v;
    print("value: ");
    print-line(v);
  }
}
