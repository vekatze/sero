import {
  core::rune {to-int32},
  core::rune.unsafe {from-int32},
  get-kit {get-int32, get-kit},
  put-kit {put-int32, put-kit},
  sero {Sero, sero},
}

define _put(k: &put-kit, x: &rune) -> unit {
  put-int32(k, to-int32(*x))
}

define _get(k: &get-kit) -> ?+rune {
  try v = get-int32(k);
  Right(lift {from-int32(v)})
}

constant rune-sero: sero(rune) {
  Sero{
    put := _put,
    get := _get,
  }
}
