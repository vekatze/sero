import {
  this.get-kit {get-int8, get-kit},
  this.put-kit {put-int8, put-kit},
  this.sero {Sero, sero},
}

define _put(k: &put-kit, x: &int8) -> unit {
  put-int8(k, *x)
}

define _get(k: &get-kit) -> ?+int8 {
  try v = get-int8(k);
  Right(lift {v})
}

constant int8-sero: sero(int8) {
  Sero{
    put := _put,
    get := _get,
  }
}
